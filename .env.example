# Cấu hình gọi LLM (python3 run.py llm). Sao chép thành .env rồi điền.
# Endpoint phải hỗ trợ API chuẩn OpenAI (/chat/completions).
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=

# PostgreSQL. Bỏ trống = container của docker-compose.yml (host=localhost port=5433 user=postgres).
# Đặt PGDATA (thư mục dữ liệu) để dùng một cụm PostgreSQL cục bộ, điều khiển bằng pg_ctl, thay cho Docker.
LT_DSN=
PGDATA=
